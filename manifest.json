{
  "manifest_version": 3,
  "name": "ServiceNow Global Search",
  "version": "1.0.0",
  "description": "Quickly run ServiceNow global search from a Chrome extension. Configure your instance domain in Options.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "ServiceNow Search",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}